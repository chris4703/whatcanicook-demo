# Copy to .env and edit privately. No live credentials or household addresses here.
# Recipe search is optional; a blank key leaves it disabled.
OPENAI_API_KEY=
# Existing application default, not a guarantee of model availability or suitability.
OPENAI_MODEL=gpt-4.1-mini

# Core demo serves HTTP on the Docker host's loopback interface only.
HTTP_PORT=18088

# Optional `https` Compose profile. Change for a deliberately configured LAN setup.
# The hostname/IP must match the URL used by the client. No DNS record is created.
PANTRY_HOST=localhost
LAN_IP=127.0.0.1
HTTPS_PORT=18443

# Set an appropriate application/contact identity before making provider requests.
OFF_USER_AGENT=PantryDemo/0.1 (your-contact@example.com)

# Optional `catalog` profile: large data download and SQLite import.
OFF_INDEX_INTERVAL_HOURS=720
